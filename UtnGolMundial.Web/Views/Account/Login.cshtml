@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4 mt-4">
            <h3 class="mb-3">Iniciar sesión</h3>
            <div asp-validation-summary="All" class="text-danger"></div>
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Correo" class="form-label">Correo</label>
                    <input asp-for="Correo" class="form-control" placeholder="tucorreo@utn.edu.ec" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>
            <p class="mt-3 mb-0">¿No tienes cuenta? <a asp-action="Registro">Regístrate</a></p>
            <p class="text-muted small mt-2">Admin de prueba: admin@utn.edu.ec / admin123</p>
        </div>
    </div>
</div>
